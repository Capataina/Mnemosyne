# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Cargo build output. Now a workspace-root target/ (the crates share one
# build directory); the per-crate src-tauri/.gitignore covered the old layout.
/target/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

images.db

# Project-local user-state directory. Holds DB, thumbnails, models,
# cosine cache, and settings — see paths.rs::app_data_dir(). Gitignored
# so user state never lands in commits.
Library/

# Bundled encoder weights. Populated by scripts/download_models.py into
# models/<modality>/ (image, audio, 3d) so the weights sit inside the repo
# tree — visible, and the source the Tauri bundler packages into each app.
# Never committed: ~2.5 GB of ONNX weights per modality. The *.onnx rule
# below already covers the .onnx files; this also excludes the tokenizer
# .json files that live alongside them.
/models/

# Local Claude Code personality — not shared
CLAUDE.md

# Python bytecode caches (created when scripts/ helpers are syntax-checked)
__pycache__/
*.pyc

# Belt-and-braces: any user-state files that might have accidentally
# been authored into the repo. Everything user-state-related lives in
# the platform app data directory (~/Library/Application Support/
# com.ataca.image-browser/ on macOS), but in case someone copies a
# stale .onnx or .db file in here while debugging:
*.onnx
*.db
*.db-journal
.thumbnails/
thumbnails/

# Cosine cache and any other binary scratch state
cosine_cache.bin
*.part

# macOS + iCloud sync artifacts
.DS_Store
* [0-9].md
* [0-9].ts
* [0-9].py
* [0-9].rs
* [0-9].json
