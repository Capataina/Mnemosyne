{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lynceus",
  "version": "0.7.19",
  "identifier": "com.capataina.lynceus",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lynceus",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "maximized": true,
        "backgroundColor": "#131519"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "12.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../models/image/clip_vision_int8.onnx": "models/clip_vision_int8.onnx",
      "../../../models/image/clip_text_int8.onnx": "models/clip_text_int8.onnx",
      "../../../models/image/clip_tokenizer.json": "models/clip_tokenizer.json",
      "../../../models/image/siglip2_vision_int8.onnx": "models/siglip2_vision_int8.onnx",
      "../../../models/image/siglip2_text_int8.onnx": "models/siglip2_text_int8.onnx",
      "../../../models/image/siglip2_tokenizer.json": "models/siglip2_tokenizer.json",
      "../../../models/image/dinov2_base_image_int8.onnx": "models/dinov2_base_image_int8.onnx"
    }
  }
}
