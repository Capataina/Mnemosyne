{
  "name": "mnemosyne-monorepo",
  "private": true,
  "version": "0.2.0",
  "description": "Monorepo for the Mnemosyne asset-browser engine and its products (Lynceus — images; Syrinx and Daedalus to come).",
  "scripts": {
    "dev": "pnpm --filter ./apps/lynceus run dev",
    "build": "pnpm --filter ./apps/lynceus run build",
    "test": "pnpm --filter ./apps/lynceus run test",
    "tauri": "pnpm --filter ./apps/lynceus run tauri",
    "lynceus:dev": "bash scripts/start_lynceus.sh dev",
    "lynceus:release": "bash scripts/start_lynceus.sh release"
  }
}
